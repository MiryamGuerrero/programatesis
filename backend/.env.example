APP_ENV=development
APP_NAME=Reuma Nutri API
APP_HOST=0.0.0.0
APP_PORT=8000

# Supabase project URL, e.g. https://<project-id>.supabase.co
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# PostgreSQL direct connection string from Supabase (SSL required)
DATABASE_URL=postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres?sslmode=require

# CORS origins as comma-separated list
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
